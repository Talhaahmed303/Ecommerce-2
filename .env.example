# Copy this file to .env and adjust variables as needed for your local environment.
# DO NOT commit real secrets or credentials to source control.

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-ecommerce-eval-secret-key-change-in-production-2026-xyz
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Port Allocation
BACKEND_PORT=8002
FRONTEND_PORT=3002

# PostgreSQL Database Configuration
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration (Next.js Storefront)
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Next.js Frontend Environment Variable
NEXT_PUBLIC_API_URL=http://127.0.0.1:8002/api
